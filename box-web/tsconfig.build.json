{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["src/*"],
      "@box/ui/*": ["../box-ui/src/*"],
      "@box/ui/types/*": ["../box-ui/src/types/*"],
      "@box/ui/setup/*": ["../box-ui/src/setup/*"],
      "@box/demo-mock": ["../box-demo-mock/src/index.ts"],
      "@box/demo-mock/*": ["../box-demo-mock/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "env.d.ts"]
}
