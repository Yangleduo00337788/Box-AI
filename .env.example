# 复制为仓库根目录 .env（已 gitignore）。应用不会解析本文件。
# 本地：IntelliJ 运行配置 BoxApplication 的 Environment variables 指向本文件（与生产注入进程环境变量一致）。
# 空值请整行注释掉，不要写成 KEY=
# Docker Compose：cd deploy && docker compose --env-file ../.env up -d
# 不要把生产密钥提交进 git。

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# k6 压测（复制到 loadtest/k6/.env 的 ACCOUNT/PASSWORD；不要用生产账号）
BOX_LOADTEST_BASE_URL=http://localhost:8080
BOX_LOADTEST_ACCOUNT=loadtest@box.local
BOX_LOADTEST_PASSWORD=Loadtest#2026
BOX_LOADTEST_ACCOUNT_TYPE=PERSONAL

SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3307/box?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=box

SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=admin123

MYSQL_ROOT_PASSWORD=box
MINIO_ROOT_USER=box
MINIO_ROOT_PASSWORD=boxsecret1

BOX_MINIO_ENDPOINT=http://127.0.0.1:9000
BOX_MINIO_ACCESS_KEY=box
BOX_MINIO_SECRET_KEY=boxsecret1
BOX_MINIO_BUCKET=box

BOX_ELASTICSEARCH_HOST=127.0.0.1
BOX_ELASTICSEARCH_PORT=9200
BOX_ELASTICSEARCH_SCHEME=http
BOX_ELASTICSEARCH_USERNAME=
BOX_ELASTICSEARCH_PASSWORD=
BOX_ELASTICSEARCH_TRUST_INSECURE=false
BOX_ELASTICSEARCH_ENABLED=true

BOX_ID_WORKER_ID=1
BOX_ID_DATACENTER_ID=1

BOX_SECURITY_JWT_SECRET=box-dev-jwt-secret-change-me-please-32b
BOX_SECURITY_CRYPTO_AES_KEY=box-dev-aes-256-key-change-me!!

# 接口 Redis 限流（登录 / Chat / 已发布 Chat / API Key / Tool / Webhook）。k6/.env 改不到这些。
# 压测：BOX_RATE_LIMIT_ENABLED=false，或把对应 per-minute 调大；0 表示该 scope 不限。生产保持 true。
BOX_RATE_LIMIT_ENABLED=true
# BOX_RATE_LIMIT_LOGIN_PER_MINUTE=20
# BOX_RATE_LIMIT_CHAT_PER_MINUTE=60
# BOX_RATE_LIMIT_PUBLISHED_CHAT_PER_MINUTE=60
# BOX_RATE_LIMIT_API_KEY_PER_MINUTE=120
# BOX_RATE_LIMIT_TOOL_EXEC_PER_MINUTE=30
# BOX_RATE_LIMIT_WEBHOOK_PER_MINUTE=60

# 套餐配额校验（AI 次数/Token、成员、工作空间、知识库）。压测可关；生产保持 true。
BOX_QUOTA_ENABLED=true

# 同时对话上限：200 路在生成，最多再排 800；队满或超时返回繁忙。生产保持 true。
BOX_CHAT_ADMISSION_ENABLED=true
# BOX_CHAT_ADMISSION_MAX_INFLIGHT=200
# BOX_CHAT_ADMISSION_MAX_QUEUE=800
# BOX_CHAT_ADMISSION_QUEUE_WAIT_SECONDS=60

BOX_AUTH_VERIFICATION_EXPOSE_CODE=false
BOX_EMBED_SKIP_DOMAIN_VERIFY=true
BOX_EMBED_GATEWAY_HOST=embed.box.ai
BOX_EMBED_GATEWAY_TLS_MODE=platform

BOX_MAIL_HOST=
BOX_MAIL_PORT=587
BOX_MAIL_USERNAME=
BOX_MAIL_PASSWORD=
BOX_MAIL_FROM=noreply@box.ai

BOX_OPENAI_API_KEY=
# OAuth：仅个人端 GitHub / Google。回调 http://localhost:8080/api/v1/auth/oauth/{provider}/callback
BOX_OAUTH_PUBLIC_BASE_URL=http://localhost:8080
BOX_OAUTH_ALLOWED_REDIRECT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BOX_OAUTH_GITHUB_ENABLED=false
BOX_OAUTH_GITHUB_CLIENT_ID=
BOX_OAUTH_GITHUB_CLIENT_SECRET=
BOX_OAUTH_GOOGLE_ENABLED=false
BOX_OAUTH_GOOGLE_CLIENT_ID=
BOX_OAUTH_GOOGLE_CLIENT_SECRET=
# 支付：仅支付宝沙箱。BOX_PAYMENT_ENABLED=true 后填开放平台沙箱应用密钥。
# 支付宝私钥/公钥粘成一行（可去掉 PEM 头尾）。notify-url 若是 127.0.0.1，支付成功后前端会主动查单。
BOX_PAYMENT_ENABLED=false
BOX_PAYMENT_PROVIDER=alipay
BOX_PAYMENT_SUCCESS_URL=http://localhost:5173/settings/plan?tab=billing&payment=success
BOX_PAYMENT_CANCEL_URL=http://localhost:5173/settings/plan?tab=plans&payment=cancel
BOX_ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
BOX_ALIPAY_APP_ID=
BOX_ALIPAY_PRIVATE_KEY=
BOX_ALIPAY_PUBLIC_KEY=
BOX_ALIPAY_NOTIFY_URL=http://localhost:8080/api/v1/billing/payments/notify/alipay
BOX_ALIPAY_RETURN_URL=http://localhost:8080/api/v1/billing/payments/return/alipay
