server:
  port: 8080

spring:
  application:
    name: box-server
  datasource:
    url: jdbc:mysql://127.0.0.1:3307/box?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
    username: root
    password: box
  data:
    redis:
      host: 127.0.0.1
      port: 6379
  flyway:
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: true
  mail:
    host: ${BOX_MAIL_HOST:}
    port: ${BOX_MAIL_PORT:587}
    username: ${BOX_MAIL_USERNAME:}
    password: ${BOX_MAIL_PASSWORD:}
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true

mybatis-flex:
  global-config:
    print-banner: false

box:
  mail:
    from: noreply@box.ai
  auth:
    verification:
      expose-code: true
  security:
    jwt:
      secret: box-dev-jwt-secret-change-me-please-32b
      expire-seconds: 86400
    crypto:
      aes-key: box-dev-aes-256-key-change-me!!
  minio:
    endpoint: http://127.0.0.1:9000
    access-key: box
    secret-key: boxsecret1
    bucket: box
  elasticsearch:
    host: 127.0.0.1
    port: 9200
  ai:
    openai:
      api-key: ${BOX_OPENAI_API_KEY:}
    embedding:
      model-name: text-embedding-3-small

logging:
  level:
    com.boxai: INFO
