# 键值来自进程环境变量（本地由 IDE 加载仓库根 .env，部署由编排注入）。application.yml 本身不含密钥。
server:
  port: ${SERVER_PORT:8080}

spring:
  application:
    name: box-server
  servlet:
    multipart:
      max-file-size: 20MB
      max-request-size: 25MB
  datasource:
    url: ${SPRING_DATASOURCE_URL}
    username: ${SPRING_DATASOURCE_USERNAME}
    password: ${SPRING_DATASOURCE_PASSWORD}
  data:
    redis:
      host: ${SPRING_DATA_REDIS_HOST}
      port: ${SPRING_DATA_REDIS_PORT}
      password: ${SPRING_DATA_REDIS_PASSWORD:}
  flyway:
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: true

mybatis-flex:
  global-config:
    print-banner: false

box:
  id:
    worker-id: ${BOX_ID_WORKER_ID:1}
    datacenter-id: ${BOX_ID_DATACENTER_ID:1}
  mail:
    from: ${BOX_MAIL_FROM:noreply@box.ai}
  auth:
    verification:
      expose-code: ${BOX_AUTH_VERIFICATION_EXPOSE_CODE:false}
  oauth:
    public-base-url: ${BOX_OAUTH_PUBLIC_BASE_URL:http://localhost:8080}
    allowed-redirect-origins: ${BOX_OAUTH_ALLOWED_REDIRECT_ORIGINS:http://localhost:5173,http://127.0.0.1:5173}
    github:
      enabled: ${BOX_OAUTH_GITHUB_ENABLED:false}
      client-id: ${BOX_OAUTH_GITHUB_CLIENT_ID:}
      client-secret: ${BOX_OAUTH_GITHUB_CLIENT_SECRET:}
    google:
      enabled: ${BOX_OAUTH_GOOGLE_ENABLED:false}
      client-id: ${BOX_OAUTH_GOOGLE_CLIENT_ID:}
      client-secret: ${BOX_OAUTH_GOOGLE_CLIENT_SECRET:}
  security:
    jwt:
      secret: ${BOX_SECURITY_JWT_SECRET}
      expire-seconds: 86400
    crypto:
      aes-key: ${BOX_SECURITY_CRYPTO_AES_KEY}
  rate-limit:
    enabled: ${BOX_RATE_LIMIT_ENABLED:true}
    login-per-minute: ${BOX_RATE_LIMIT_LOGIN_PER_MINUTE:20}
    chat-per-minute: ${BOX_RATE_LIMIT_CHAT_PER_MINUTE:60}
    published-chat-per-minute: ${BOX_RATE_LIMIT_PUBLISHED_CHAT_PER_MINUTE:60}
    api-key-per-minute: ${BOX_RATE_LIMIT_API_KEY_PER_MINUTE:120}
    tool-exec-per-minute: ${BOX_RATE_LIMIT_TOOL_EXEC_PER_MINUTE:30}
    webhook-per-minute: ${BOX_RATE_LIMIT_WEBHOOK_PER_MINUTE:60}
  quota:
    enabled: ${BOX_QUOTA_ENABLED:true}
  chat-admission:
    enabled: ${BOX_CHAT_ADMISSION_ENABLED:true}
    max-inflight: ${BOX_CHAT_ADMISSION_MAX_INFLIGHT:200}
    max-queue: ${BOX_CHAT_ADMISSION_MAX_QUEUE:800}
    queue-wait-seconds: ${BOX_CHAT_ADMISSION_QUEUE_WAIT_SECONDS:60}
  embed:
    skip-domain-verify: ${BOX_EMBED_SKIP_DOMAIN_VERIFY:true}
    gateway-host: ${BOX_EMBED_GATEWAY_HOST:embed.box.ai}
    gateway-tls-mode: ${BOX_EMBED_GATEWAY_TLS_MODE:platform}
  payment:
    enabled: ${BOX_PAYMENT_ENABLED:false}
    provider: ${BOX_PAYMENT_PROVIDER:alipay}
    success-url: ${BOX_PAYMENT_SUCCESS_URL:http://localhost:5173/settings/plan?tab=billing&payment=success}
    cancel-url: ${BOX_PAYMENT_CANCEL_URL:http://localhost:5173/settings/plan?tab=plans&payment=cancel}
    alipay:
      gateway-url: ${BOX_ALIPAY_GATEWAY_URL:https://openapi-sandbox.dl.alipaydev.com/gateway.do}
      app-id: ${BOX_ALIPAY_APP_ID:}
      private-key: ${BOX_ALIPAY_PRIVATE_KEY:}
      alipay-public-key: ${BOX_ALIPAY_PUBLIC_KEY:}
      notify-url: ${BOX_ALIPAY_NOTIFY_URL:http://localhost:8080/api/v1/billing/payments/notify/alipay}
      return-url: ${BOX_ALIPAY_RETURN_URL:http://localhost:8080/api/v1/billing/payments/return/alipay}
  minio:
    endpoint: ${BOX_MINIO_ENDPOINT}
    access-key: ${BOX_MINIO_ACCESS_KEY}
    secret-key: ${BOX_MINIO_SECRET_KEY}
    bucket: ${BOX_MINIO_BUCKET:box}
  elasticsearch:
    host: ${BOX_ELASTICSEARCH_HOST}
    port: ${BOX_ELASTICSEARCH_PORT:9200}
    scheme: ${BOX_ELASTICSEARCH_SCHEME:http}
    username: ${BOX_ELASTICSEARCH_USERNAME:}
    password: ${BOX_ELASTICSEARCH_PASSWORD:}
    trust-insecure-certificate: ${BOX_ELASTICSEARCH_TRUST_INSECURE:false}
    enabled: ${BOX_ELASTICSEARCH_ENABLED:true}
  ai:
    openai:
      api-key: ${BOX_OPENAI_API_KEY:}
    embedding:
      model-name: text-embedding-3-small

management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics,prometheus
  endpoint:
    health:
      show-details: when_authorized
  health:
    mail:
      enabled: false
  metrics:
    tags:
      application: ${spring.application.name}

logging:
  level:
    com.boxai: INFO
