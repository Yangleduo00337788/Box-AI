server:
  port: 8080

spring:
  application:
    name: box-server
  servlet:
    multipart:
      max-file-size: 20MB
      max-request-size: 25MB
  datasource:
    url: jdbc:mysql://127.0.0.1:3307/box?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
    username: root
    password: box
  data:
    redis:
      host: 127.0.0.1
      port: 6379
  flyway:
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: true
  mail:
    host: ${BOX_MAIL_HOST:}
    port: ${BOX_MAIL_PORT:587}
    username: ${BOX_MAIL_USERNAME:}
    password: ${BOX_MAIL_PASSWORD:}
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true

mybatis-flex:
  global-config:
    print-banner: false

box:
  mail:
    from: noreply@box.ai
  auth:
    verification:
      expose-code: true
  oauth:
    github:
      enabled: false
      client-id: ${BOX_OAUTH_GITHUB_CLIENT_ID:}
      client-secret: ${BOX_OAUTH_GITHUB_CLIENT_SECRET:}
    google:
      enabled: false
      client-id: ${BOX_OAUTH_GOOGLE_CLIENT_ID:}
      client-secret: ${BOX_OAUTH_GOOGLE_CLIENT_SECRET:}
    sso:
      enabled: false
      issuer-uri: ${BOX_OAUTH_SSO_ISSUER_URI:}
  security:
    jwt:
      secret: box-dev-jwt-secret-change-me-please-32b
      expire-seconds: 86400
    crypto:
      aes-key: box-dev-aes-256-key-change-me!!
  embed:
    # 本地开发可跳过 TXT / well-known 校验；生产必须为 false
    skip-domain-verify: true
    gateway-host: embed.box.ai
    gateway-tls-mode: platform
  payment:
    enabled: false
    provider: mock
    success-url: http://127.0.0.1:5173/settings/plan?tab=billing&payment=success
    cancel-url: http://127.0.0.1:5173/settings/plan?tab=plans&payment=cancel
    stripe:
      secret-key: ${BOX_STRIPE_SECRET_KEY:}
      webhook-secret: ${BOX_STRIPE_WEBHOOK_SECRET:}
    alipay:
      gateway-url: https://openapi.alipay.com/gateway.do
      app-id: ${BOX_ALIPAY_APP_ID:}
      private-key: ${BOX_ALIPAY_PRIVATE_KEY:}
      alipay-public-key: ${BOX_ALIPAY_PUBLIC_KEY:}
      notify-url: http://127.0.0.1:8080/api/v1/billing/payments/notify/alipay
  minio:
    endpoint: http://127.0.0.1:9000
    access-key: box
    secret-key: boxsecret1
    bucket: box
  elasticsearch:
    host: 127.0.0.1
    port: 9200
  ai:
    openai:
      api-key: ${BOX_OPENAI_API_KEY:}
    embedding:
      model-name: text-embedding-3-small

logging:
  level:
    com.boxai: INFO
