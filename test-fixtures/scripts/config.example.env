# 冒烟与环境变量示例（复制为 config.env，勿提交）

# API 根地址（无末尾斜杠）
BOX_SMOKE_BASE_URL=http://127.0.0.1:8080

# 可选：手工登录冒烟用的测试账号（Phase 2 手工，脚本默认不用）
# BOX_TEST_EMAIL=release-gate@example.com
# BOX_TEST_PASSWORD=ChangeMe123!

# MySQL（加载 conversation-plugins SQL 时用）
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=root
# MYSQL_DATABASE=box
